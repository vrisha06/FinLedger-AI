# ==============================================================================
# FinLedger-AI — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# IMPORTANT: .env is excluded from Git. Never commit real credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL 16 Configuration (Default Local Windows Setup)
# DB_PASSWORD is mandatory (no hardcoded fallback). Special characters are safely escaped.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=finledger
DB_TEST_NAME=finledger_test

# Database Connection URLs (Optional overrides)
# If omitted or left empty, URLs are constructed automatically from the DB_* variables above.
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/finledger
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/finledger_test

# Authentication & Security
# SECRET_KEY is mandatory (no hardcoded fallback).
# Generate a secure 32-byte hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_key_for_jwt_signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Double-Entry Ledger Settings
DEFAULT_CURRENCY=INR
CLEARING_ACCOUNT_NUMBER=INR-SYS-CLEARING

# AI & Fraud Detection Settings
FRAUD_RISK_THRESHOLD=0.70
RANDOM_SEED=42
